<?xml version="1.0" encoding="UTF-8" ?>
<templates>
    <t t-name="l10n_ve_reports.GeneralLedgerFilters" t-inherit="l10n_ve_reports.AccountReportFiltersCustomizable">
        <xpath expr="//div[@id='filter_extra_options']" position="before">
            <t t-if="controller.options.available_currencies and controller.options.available_currencies.length > 0">
                <div id="filter_currency_conversion">
                    <t t-call="l10n_ve_reports.GeneralLedgerCurrencyConversion"/>
                </div>
            </t>
        </xpath>
    </t>

    <t t-name="l10n_ve_reports.GeneralLedgerCurrencyConversion">
        <Dropdown>
            <button class="btn btn-secondary">
                <i class="fa fa-exchange me-1"/>
                <t t-if="!controller.options.convert_to_currency">
                    Moneda: Sin conversión
                </t>
                <t t-if="controller.options.convert_to_currency">
                    Moneda: <t t-out="selectedCurrencyName"/>
                </t>
            </button>

            <t t-set-slot="content">
                <DropdownItem
                    class="{ selected: !controller.options.convert_to_currency }"
                    onSelected="() => this.onCurrencyChange(false)"
                    closingMode="'none'"
                >
                    Sin conversión
                </DropdownItem>
                <t t-foreach="controller.options.available_currencies" t-as="currency" t-key="currency.id">
                    <DropdownItem
                        class="{ selected: controller.options.convert_to_currency === currency.id }"
                        onSelected="() => this.onCurrencyChange(currency.id)"
                        closingMode="'none'"
                    >
                        <t t-out="currency.name"/>
                    </DropdownItem>
                </t>
                
                <t t-if="controller.options.convert_to_currency">
                    <div class="dropdown-divider"/>
                    
                    <div class="dropdown-item">
                        <div class="form-check">
                            <input
                                type="checkbox"
                                class="form-check-input"
                                t-att-checked="controller.options.use_document_date || false"
                                t-on-change="(ev) => this.onUseDocumentDateChange(ev)"
                                id="use_document_date_checkbox_gl"
                            />
                            <label class="form-check-label mb-0" for="use_document_date_checkbox_gl">
                                Usar fecha del documento
                            </label>
                        </div>
                    </div>
                    
                    <t t-if="!controller.options.use_document_date">
                        <div class="dropdown-item">
                            <label class="form-label mb-1">Fecha de tasa:</label>
                            <input
                                type="date"
                                class="form-control form-control-sm"
                                t-att-value="controller.options.currency_rate_date"
                                t-on-change="(ev) => this.onCurrencyRateDateChange(ev)"
                            />
                        </div>
                    </t>
                </t>
            </t>
        </Dropdown>
    </t>
</templates>

