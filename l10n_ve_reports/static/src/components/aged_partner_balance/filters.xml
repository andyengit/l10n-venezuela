<?xml version="1.0" encoding="UTF-8" ?>
<templates>
    <t t-name="l10n_ve_reports.AgedPartnerBalanceFilters" t-inherit="l10n_ve_reports.AccountReportFiltersCustomizable">
        <xpath expr="//div[@id='filter_extra_options']" position="before">
            <t t-if="'aging_based_on' in controller.options">
                <div>
                    <t t-call="l10n_ve_reports.AccountReportAgingBasedOn"/>
                </div>
            </t>
            <t>
                <div id="filter_aging_interval">
                    <t t-call="l10n_ve_reports.AccountReportAgingInterval"/>
                </div>
            </t>
            <t t-if="controller.options.available_currencies and controller.options.available_currencies.length > 0">
                <div id="filter_currency_conversion">
                    <t t-call="l10n_ve_reports.AgedPartnerBalanceCurrencyConversion"/>
                </div>
            </t>
        </xpath>

        <xpath expr="//div[@id='filter_extra_options']" position="replace">
            <t t-call="l10n_ve_reports.AgedPartnerBalanceFilterExtraOptions"/>
        </xpath>
    </t>
</templates>
