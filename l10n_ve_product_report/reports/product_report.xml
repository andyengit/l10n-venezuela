<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Acción del reporte -->
    <record id="action_product_report" model="ir.actions.report">
        <field name="name">Reporte de Productos con Precios</field>
        <field name="model">product.report.wizard</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">l10n_ve_product_report.product_report_template</field>
        <field name="report_file">l10n_ve_product_report.product_report_template</field>
        <field name="print_report_name">'Reporte_Productos_%s' % (object.pricelist_ids[0].name if object.pricelist_ids else 'General')</field>
        <field name="binding_model_id" ref="model_product_report_wizard"/>
        <field name="binding_type">report</field>
    </record>
</odoo>
