<?xml version="1.0" encoding="utf-8" ?>
<odoo noupdate="1">
    <record id="rule_basic" model="hr.salary.rule">
        <field name="name">Salario Base</field>
        <field name="sequence" eval="1" />
        <field name="code">BASIC</field>
        <field name="category_id" ref="l10n_ve_payroll.category_basic" />
        <field name="condition_select">none</field>
        <field name="amount_select">code</field>
        <field name="amount_python_compute">result = contract.wage</field>
    </record>
    <record id="rule_alicuota_util" model="hr.salary.rule">
        <field name="name">Alícuota Utilidades</field>
        <field name="sequence" eval="5" />
        <field name="code">ALICUOTA_UTIL</field>
        <field name="category_id" ref="l10n_ve_payroll.category_alw" />
        <field name="condition_select">none</field>
        <field name="amount_select">percentage</field>
        <field name="amount_percentage" eval="8.33" />
        <field name="amount_percentage_base">contract.wage</field>
    </record>
    <record id="rule_alicuota_bv" model="hr.salary.rule">
        <field name="name">Alícuota Bono Vacacional</field>
        <field name="sequence" eval="10" />
        <field name="code">ALICUOTA_BV</field>
        <field name="category_id" ref="l10n_ve_payroll.category_alw" />
        <field name="condition_select">none</field>
        <field name="amount_select">percentage</field>
        <field name="amount_percentage" eval="4.16" />
        <field name="amount_percentage_base">contract.wage</field>
    </record>
    <record id="rule_sal_integral" model="hr.salary.rule">
        <field name="name">Salario Integral</field>
        <field name="sequence" eval="15" />
        <field name="code">SAL_INTEGRAL</field>
        <field name="category_id" ref="l10n_ve_payroll.category_sal_integral" />
        <field name="condition_select">none</field>
        <field name="amount_select">code</field>
        <field name="appears_on_payslip" eval="False" />
        <field name="amount_python_compute">result = categories.BASIC + categories.ALW</field>
    </record>
    <record id="rule_gross" model="hr.salary.rule">
        <field name="name">Sueldo Bruto</field>
        <field name="sequence" eval="100" />
        <field name="code">GROSS</field>
        <field name="category_id" ref="l10n_ve_payroll.category_gross" />
        <field name="condition_select">none</field>
        <field name="amount_select">code</field>
        <field name="amount_python_compute">result = categories.BASIC + categories.ALW</field>
    </record>
    <record id="rule_faov_emp" model="hr.salary.rule">
        <field name="name">FAOV Empleador</field>
        <field name="sequence" eval="110" />
        <field name="code">FAOV_EMP</field>
        <field name="category_id" ref="l10n_ve_payroll.category_comp" />
        <field name="condition_select">none</field>
        <field name="amount_select">percentage</field>
        <field name="amount_percentage" eval="2.0" />
        <field name="amount_percentage_base">result_rules.SAL_INTEGRAL.total</field>
        <field name="register_id" ref="l10n_ve_payroll.contrib_register_faov" />
    </record>
    <record id="rule_faov_trab" model="hr.salary.rule">
        <field name="name">FAOV Trabajador</field>
        <field name="sequence" eval="120" />
        <field name="code">FAOV_TRAB</field>
        <field name="category_id" ref="l10n_ve_payroll.category_ded" />
        <field name="condition_select">none</field>
        <field name="amount_select">percentage</field>
        <field name="amount_percentage" eval="-1.0" />
        <field name="amount_percentage_base">result_rules.SAL_INTEGRAL.total</field>
        <field name="register_id" ref="l10n_ve_payroll.contrib_register_faov" />
    </record>
    <record id="rule_net" model="hr.salary.rule">
        <field name="name">Sueldo Neto</field>
        <field name="sequence" eval="200" />
        <field name="code">NET</field>
        <field name="category_id" ref="l10n_ve_payroll.category_net" />
        <field name="condition_select">none</field>
        <field name="amount_select">code</field>
        <field name="amount_python_compute">result = categories.BASIC + categories.ALW + categories.DED</field>
    </record>
</odoo>
