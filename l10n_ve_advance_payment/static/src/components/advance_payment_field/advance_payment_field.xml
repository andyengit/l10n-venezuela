<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="l10n_ve_advance_payment.AdvancePaymentField">
        <div class="o_l10n_ve_advance_widget">
            <t t-set="info" t-value="this.getInfo()"/>
            <div>
                <strong class="float-start" t-out="info.title"/>
            </div>
            <table style="width:100%;">
                <t t-foreach="info.lines" t-as="line" t-key="line_index">
                    <tr>
                        <td>
                            <a
                                role="button"
                                class="oe_form_field btn btn-secondary"
                                style="margin-right: 0px; padding-left: 5px; padding-right: 5px;"
                                href="#"
                                t-on-click.prevent="() => this.applyAdvance(info.moveId, line.id)"
                            >Aplicar</a>
                        </td>
                        <td style="max-width: 13em;">
                            <span
                                class="oe_form_field"
                                style="display:block; text-overflow: ellipsis; overflow: hidden; white-space: nowrap;"
                                t-att-title="line.payment_name"
                                t-out="line.payment_name"
                            />
                            <small class="text-muted" t-if="line.formattedDate">
                                <t t-out="line.formattedDate"/> - <t t-out="line.journal_name"/>
                            </small>
                        </td>
                        <td style="text-align:right;">
                            <span class="oe_form_field oe_form_field_float oe_form_field_monetary">
                                <t t-out="line.amount_formatted"/>
                            </span>
                        </td>
                    </tr>
                </t>
            </table>
        </div>
    </t>

</templates>
