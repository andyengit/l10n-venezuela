<odoo>
    <record id="view_move_form_inherit_l10n_ve_advance_payment_widget" model="ir.ui.view">
        <field name="name">account.move.form.inherit.l10n_ve_advance_payment.widget</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='invoice_outstanding_credits_debits_widget']/.." position="after">
                <group class="oe_subtotal_footer px-4" invisible="move_type != 'out_invoice' or state != 'posted'">
                    <field
                        name="l10n_ve_advance_widget"
                        class="oe_invoice_outstanding_credits_debits py-3"
                        colspan="2"
                        nolabel="1"
                        widget="l10n_ve_advance_payment"
                        invisible="not l10n_ve_has_advance_available"
                    />
                </group>
            </xpath>
        </field>
    </record>
</odoo>
