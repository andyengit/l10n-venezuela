<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="purchase_order_form_inherit_update_cost" model="ir.ui.view">
        <field name="name">purchase.order.form.inherit.update.cost</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_toggle_update_cost"
                    type="object"
                    class="oe_stat_button"
                    icon="fa-refresh"
                    invisible="state in ('cancel', 'done', 'purchase')">
                    <label for="update_product_cost" string="Actualizar Coste"/>
                    <field name="update_product_cost"
                        widget="boolean_button"
                        class="ps-1"
                        options='{"terminology": {"string_true": "Actualizar Coste", "hover_true": "No Actualizar", "string_false": "Sin Actualizar", "hover_false": "Actualizar Coste"}}'/>
                </button>
            </xpath>
        </field>
    </record>
</odoo>
