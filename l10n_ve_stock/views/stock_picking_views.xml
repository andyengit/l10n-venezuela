<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_picking_form_inherit_l10n_ve" model="ir.ui.view">
        <field name="name">stock.picking.form.inherit.l10n.ve</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='note']" position="before">
                <field name="l10n_ve_is_ve_country" invisible="1" />
                <field name="l10n_ve_transfer_reason" string="Motivo del traslado" placeholder="Indique el motivo del traslado de los bienes (ej: Consignación, Préstamo, Muestra, Reubicación, etc.)" invisible="not l10n_ve_is_ve_country" />
            </xpath>
        </field>
    </record>
</odoo>