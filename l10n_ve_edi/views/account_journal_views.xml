<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_account_journal_form_l10n_ve_edi" model="ir.ui.view">
        <field name="name">account.journal.form.l10n.ve.edi</field>
        <field name="model">account.journal</field>
        <field name="inherit_id" ref="account.view_account_journal_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Facturacion digital (EDI)" invisible="type != 'sale'">
                    <group>
                        <field name="l10n_ve_edi_provider"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
